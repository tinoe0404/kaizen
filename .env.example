# SMTP server hostname (e.g., smtp.gmail.com or smtp.postmarkapp.com)
SMTP_HOST=

# SMTP server port (e.g., 587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT=587

# Use TLS: "true" for port 465, "false" for other ports like 587
SMTP_SECURE=false

# SMTP authentication username / account email
SMTP_USER=

# SMTP authentication password or app-specific password
SMTP_PASS=

# Sender display name in the From header
MAIL_FROM_NAME=Kaizen Travel and Adventures

# Destination inbox for incoming trip booking requests
BOOKING_EMAIL=

# Set to "true" in non-production environments to log emails to console instead of sending
MAIL_DRY_RUN=true

# Canonical site URL (e.g. https://kaizentravel.co.zw). Required in production.
NEXT_PUBLIC_SITE_URL=

# Google Search Console verification code (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

